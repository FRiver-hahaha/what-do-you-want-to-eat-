root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{c,cc,cpp,h,hpp}]
indent_size = 4

[*.{js,json,yml,yaml,md}]
indent_size = 2

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf