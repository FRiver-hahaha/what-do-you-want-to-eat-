# ============================================================================
# DRAFT ONLY — 配置模板草案（P8-S0，未入库为正式 .env.example）
# 用途：P8 新增 HTTP 进程（server_http）与 Agent 直连所需的配置项。
# 规则：
#   ① 本文件只含占位符与安全默认值，禁止填写任何真实密码 / Token / 授权码；
#   ② 生产环境将所有 <...> 占位符替换后写入 .env（已 gitignore），不得提交；
#   ③ 敏感项变更需走密钥保管流程（责任人见 P8-17 §5）。
# ============================================================================

# ============================ P8 新增：HTTP 业务进程 ============================
# ---- 监听（默认仅回环，生产由 nginx 反代终止 TLS）----
CHATROOM_HTTP_BIND=127.0.0.1
CHATROOM_HTTP_PORT=8080

# ---- Bearer 认证（必填；与 Agent 侧 EAT_SERVER_TOKEN 同值）----
# 生成：openssl rand -hex 32；轮换时两端同时更新并重启
CHATROOM_HTTP_TOKEN=<REPLACE_WITH_RANDOM_32_BYTE_HEX>

# ---- 用户模式（fail-closed）----
# 仅接受 p4_demo（默认）：Auth 层白名单 uid == "u_demo"
# multi（未实现）→ 启动 FATAL；未知值 → 启动 FATAL
CHATROOM_HTTP_USER_MODE=p4_demo

# ---- 数据库连接池大小 S（协议：不设固定 32 上限）----
# 默认留空 = W = max(8, cores-1)；高压档按全局预算计算：
#   S = min(4W, max_connections - 8(TCP 既有池) - 其他服务 - 运维预留>=5)
CHATROOM_HTTP_DB_POOL=

# ---- 时区自检（0=WARNING，1=FATAL）----
CHATROOM_TZ_STRICT=0

# ---- 日志 ----
# 复用 glog；默认输出 stderr（systemd 收集）。如需落盘：
#   GLOG_log_dir=/var/log/chatroom
GLOG_log_dir=
GLOG_minloglevel=0

# ============================ MySQL（HTTP 进程复用同一组变量）============================
CHATROOM_MYSQL_HOST=127.0.0.1
CHATROOM_MYSQL_PORT=3306
CHATROOM_MYSQL_USER=chatserver
CHATROOM_MYSQL_PASSWORD=<REPLACE_WITH_DB_PASSWORD>
CHATROOM_MYSQL_DB=chatroom

# ============================ Redis（HTTP 进程不连接）============================
# 说明：P8 HTTP 进程不使用 Redis；以下仅为既有 TCP 进程保留，勿误以为 HTTP 依赖。
CHATROOM_REDIS_HOST=127.0.0.1
CHATROOM_REDIS_PORT=6379
CHATROOM_REDIS_PASSWORD=<REPLACE_WITH_REDIS_PASSWORD_OR_EMPTY>

# ============================ Agent 侧（不属于 C++ 进程）============================
# 由学长侧 .env 配置；C++ 只消费其产生的 Bearer 头。
# EAT_SERVER_BASE_URL=http://127.0.0.1:8080
# EAT_SERVER_TOKEN=<SAME_VALUE_AS_CHATROOM_HTTP_TOKEN>
# EAT_SERVICE_TIMEOUT=5

# ============================ 既有 TCP 进程（保持原样，勿改）============================
CHATROOM_PORT=8000
CHATROOM_WORKER_THREADS=4