# ============================================================
# ChatRoom 运行配置模板
# 用法: cp .env.example .env && vi .env && set -a && . ./.env && set +a
# 说明: 所有敏感项只允许出现在 .env（已 gitignore），禁止写入源码。
# ============================================================

# ---- 服务监听 ----
CHATROOM_PORT=8000
CHATROOM_WORKER_THREADS=4

# ---- MySQL（必需）----
CHATROOM_MYSQL_HOST=127.0.0.1
CHATROOM_MYSQL_PORT=3306
CHATROOM_MYSQL_USER=chatserver
CHATROOM_MYSQL_PASSWORD=
CHATROOM_MYSQL_DB=chatroom

# ---- Redis（必需）----
CHATROOM_REDIS_HOST=127.0.0.1
CHATROOM_REDIS_PORT=6379
# 未设置密码时留空；设置后必须与 redis.conf 的 requirepass 一致
CHATROOM_REDIS_PASSWORD=

# ---- SMTP（发送验证码 / 找回密码 必需）----
# 留空时：服务可启动，但 TYPE=3 返回 {"code":0,"msg":"邮件发送失败"}
# 安全要求：历史提交中出现过的授权码必须到邮箱后台重置后再填入
CHATROOM_SMTP_USER=
CHATROOM_SMTP_AUTH=
CHATROOM_SMTP_URL=smtps://smtp.qq.com:465

# ---- 测试专用：仅自动化测试可置 1 ----
# 置 1 时不真正发信，而是把验证码打印到日志（生产环境必须删除该行）
CHATROOM_SMTP_DRY_RUN=0

# ---- 验证码策略（秒 / 次）----
CHATROOM_CODE_TTL=300
CHATROOM_CODE_RESEND=60
CHATROOM_CODE_MAX_ATTEMPTS=5
# ============================================================
# P8 HTTP 业务进程（server_http）
# 说明: 与上面的 TCP 进程共用 MySQL 配置；此进程不连接 Redis。
#       Token 与 Agent 侧 EAT_SERVER_TOKEN 必须同值。
# ============================================================

# ---- 监听（默认仅回环，生产由 nginx 等反向代理终止 TLS）----
CHATROOM_HTTP_BIND=127.0.0.1
CHATROOM_HTTP_PORT=8080

# ---- Bearer 认证（必填；生成：openssl rand -hex 32）----
CHATROOM_HTTP_TOKEN=<REPLACE_WITH_RANDOM_32_BYTE_HEX>

# ---- 用户模式（fail-closed）----
# p4_demo：仅允许 uid == "u_demo"（演示隔离，非正式认证）
# multi：尚未实现，启动即 FATAL；未知值同样 FATAL
CHATROOM_HTTP_USER_MODE=p4_demo

# ---- 工作线程与连接池 ----
# 工作线程 W 默认 max(8, cores-1)；连接池 S 留空时等于 W。
# S 需按全局预算设置：S = min(4W, max_connections - TCP 池 - 其他服务 - 运维预留)
CHATROOM_HTTP_WORKERS=
CHATROOM_HTTP_DB_POOL=

# ---- 菜单/搜索接口的归属用户（该接口不携带 user_id）----
# 必须存在于 Auth 白名单，否则启动 FATAL
CHATROOM_HTTP_FOOD_USER=u_demo

# ---- 日志与启动诊断 ----
# 置 1 会把 Token 打印到 stdout，仅限本地排查，生产必须为 0
CHATROOM_HTTP_TOKEN_STDOUT=0

