# ============================================================
# ChatRoom 运行配置模板
# 用法: cp .env.example .env && vi .env && set -a && . ./.env && set +a
# 说明: 所有敏感项只允许出现在 .env（已 gitignore），禁止写入源码。
# ============================================================

# ---- 服务监听 ----
CHATROOM_PORT=8000
CHATROOM_WORKER_THREADS=4

# ---- MySQL（必需）----
CHATROOM_MYSQL_HOST=127.0.0.1
CHATROOM_MYSQL_PORT=3306
CHATROOM_MYSQL_USER=chatserver
CHATROOM_MYSQL_PASSWORD=
CHATROOM_MYSQL_DB=chatroom

# ---- Redis（必需）----
CHATROOM_REDIS_HOST=127.0.0.1
CHATROOM_REDIS_PORT=6379
# 未设置密码时留空；设置后必须与 redis.conf 的 requirepass 一致
CHATROOM_REDIS_PASSWORD=

# ---- SMTP（发送验证码 / 找回密码 必需）----
# 留空时：服务可启动，但 TYPE=3 返回 {"code":0,"msg":"邮件发送失败"}
# 安全要求：历史提交中出现过的授权码必须到邮箱后台重置后再填入
CHATROOM_SMTP_USER=
CHATROOM_SMTP_AUTH=
CHATROOM_SMTP_URL=smtps://smtp.qq.com:465

# ---- 测试专用：仅自动化测试可置 1 ----
# 置 1 时不真正发信，而是把验证码打印到日志（生产环境必须删除该行）
CHATROOM_SMTP_DRY_RUN=0

# ---- 验证码策略（秒 / 次）----
CHATROOM_CODE_TTL=300
CHATROOM_CODE_RESEND=60
CHATROOM_CODE_MAX_ATTEMPTS=5
