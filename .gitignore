# 开发与测试临时目录（用户态数据库、日志、快照），不进入版本库
.dev/
build/
data/agent/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example

# 本地登录配置（含明文密码，不提交）
login.json
*.log
*.db
*.db-wal
*.db-shm

# IDE/工具目录：只保留项目规格文档
.codeartsdoer/*
!.codeartsdoer/specs/
!.codeartsdoer/specs/**

# 本地编辑器/调试残留
.arts/
*.rdb

# 本地构建产物
dist/
build-release/
build-win/

# 本地 WebView2 SDK（构建期依赖，不提交）
third_party/webview2/
third_party/*.nupkg

# Windows 构建中间产物
*.exe
*.dll
*.pdb
*.ilk
*.user
.vs/
CMakeUserPresets.json
webview-data/
